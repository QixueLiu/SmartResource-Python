# The server binds 127.0.0.1 by default. Expose only on Tailscale/private network when needed.
SMARTRESOURCE_DB=./data/smartresource.db
SMARTRESOURCE_API_TOKEN=replace-with-long-random-token

# Optional local AI (off by default)
SMARTRESOURCE_AI_ENABLED=0
SMARTRESOURCE_OLLAMA_MODEL=qwen2.5-coder:3b
SMARTRESOURCE_OLLAMA_URL=http://127.0.0.1:11434
